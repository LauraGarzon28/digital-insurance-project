meta {
  name: 2. Emitir poliza
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/polizas
  body: json
}

body:json {
  {
    "cotizacionId": "{{cotizacionId}}",
    "fechaInicio": "2026-01-01",
    "fechaFin": "2026-12-31"
  }
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("estado VIGENTE", function() {
    expect(res.body.estado).to.equal("VIGENTE");
  });
}

script:post-response {
  bru.setVar("polizaId", res.body.id);
}
