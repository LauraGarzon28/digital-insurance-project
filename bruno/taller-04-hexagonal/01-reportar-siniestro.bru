meta {
  name: Reportar siniestro
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "polizaId": "33333333-3333-3333-3333-333333333333",
    "descripcion": "Choque frontal",
    "valorAseguradoPoliza": 50000
  }
}

assert {
  res.status: eq 201
  res.body.estado: eq REPORTADO
}

script:post-response {
  bru.setVar("siniestroId", res.body.id);
}

docs {
  Recorrido completo del hexágono: adaptador REST -> puerto primario SiniestroUseCase -> aplicación -> dominio -> puerto secundario -> adaptador en memoria.
  Ejecuta los requests de esta carpeta EN ORDEN: este guarda el id en la variable siniestroId.
}
