meta {
  name: Reportar siniestro con datos inválidos
  type: http
  seq: 7
}

post {
  url: http://localhost:8080/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "polizaId": "{{polizaId}}",
    "descripcion": ""
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: eq La descripción del siniestro no puede estar vacía
}

docs {
  Las validaciones de la factory responden 400 a través del advice del controller.
}
