meta {
  name: Consultar siniestro inexistente
  type: http
  seq: 5
}

get {
  url: http://localhost:8080/api/siniestros/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.mensaje: eq No existe el siniestro 00000000-0000-0000-0000-000000000000
}

docs {
  El dominio lanza SiniestroNoEncontradoException y el advice la traduce a 404.
}
