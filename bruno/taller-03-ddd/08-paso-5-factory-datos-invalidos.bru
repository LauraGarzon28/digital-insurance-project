meta {
  name: Paso 5 - Datos inválidos en la factory
  type: http
  seq: 8
}

post {
  url: http://localhost:8080/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "polizaId": "{{polizaId}}",
    "descripcion": ""
  }
}

assert {
  res.status: eq 400
  res.body.mensaje: eq La descripción del siniestro no puede estar vacía
}

docs {
  Factory (paso 5): nadie puede construir un siniestro a medio armar; la factory valida
  los datos antes de crear la entidad.
}
