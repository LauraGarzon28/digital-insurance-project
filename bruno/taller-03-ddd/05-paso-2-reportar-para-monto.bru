meta {
  name: Paso 2 - Reportar para probar el tope del monto
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "polizaId": "33333333-3333-3333-3333-333333333333",
    "descripcion": "Daños por agua",
    "valorAseguradoPoliza": 1000000
  }
}

assert {
  res.status: eq 201
  res.body.estado: eq REPORTADO
}

script:post-response {
  bru.setVar("siniestroC", res.body.id);
}

docs {
  Crea un tercer siniestro con valor asegurado de 1.000.000 (guardado en siniestroC)
  para probar el value object MontoAprobado en el siguiente request.
}
