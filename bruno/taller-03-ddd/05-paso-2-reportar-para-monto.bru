meta {
  name: Paso 2 - Reportar para probar el tope del monto
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "polizaId": "{{polizaId}}",
    "descripcion": "Daños por agua"
  }
}

assert {
  res.status: eq 201
  res.body.estado: eq REPORTADO
}

script:post-response {
  bru.setVar("siniestroC", res.body.id);
}

docs {
  Crea un tercer siniestro sobre la póliza configurada (guardado en siniestroC)
  para probar el value object MontoAprobado en el siguiente request.
}
