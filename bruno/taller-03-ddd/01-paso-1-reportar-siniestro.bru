meta {
  name: Paso 1 - Reportar siniestro (lenguaje ubicuo)
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "polizaId": "33333333-3333-3333-3333-333333333333",
    "descripcion": "Choque frontal",
    "valorAseguradoPoliza": 50000
  }
}

assert {
  res.status: eq 201
  res.body.estado: eq REPORTADO
}

script:post-response {
  bru.setVar("siniestroA", res.body.id);
}

docs {
  El siniestro nace en estado REPORTADO (paso 1: lenguaje ubicuo del dominio).
  Ejecuta los requests de esta carpeta EN ORDEN: este guarda el id en la variable siniestroA.
}
