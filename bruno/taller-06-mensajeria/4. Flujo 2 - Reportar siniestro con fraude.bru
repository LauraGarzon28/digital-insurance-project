meta {
  name: Flujo 2 - Reportar siniestro con indicio de fraude
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/siniestros
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "polizaId": "44444444-4444-4444-4444-444444444444",
    "descripcion": "Siniestro reportado con documentación inconsistente",
    "valorAseguradoPoliza": 80000
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("flujo2SiniestroId", res.body.id);
  }
}

tests {
  test("El siniestro se registra sin decidir todavía", function() {
    expect(res.status).to.equal(201);
    expect(res.body.estado).to.equal("REPORTADO");
  });
}

docs {
  ## Flujo 2 · Reportar con indicio de fraude

  Segundo flujo del taller. Se reporta un siniestro que luego se rechazará por
  fraude, para demostrar que la regla del dominio también publica un hecho.
}
