meta {
  name: Flujo 1 - Consultar auditoría asíncrona
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/auditoria/siniestros/{{flujo1SiniestroId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("La auditoría recibió los dos hechos por RabbitMQ", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    expect(res.body.length).to.be.at.least(2);
  });

  test("El primer hecho es SiniestroReportado", function() {
    expect(res.body[0].tipo).to.equal("SiniestroReportado");
    expect(res.body[0].estado).to.equal("REPORTADO");
  });

  test("El segundo hecho es SiniestroResuelto con el monto", function() {
    const resuelto = res.body.find(evento => evento.tipo === "SiniestroResuelto");
    expect(resuelto).to.not.be.undefined;
    expect(resuelto.estado).to.equal("APROBADO");
    expect(Number(resuelto.montoAprobado)).to.equal(10000);
  });
}

docs {
  ## Flujo 1 · Verificar la auditoría

  Esta petición prueba la conexión **asíncrona**: `siniestros-service` publicó en
  RabbitMQ y `auditoria-service` consumió sin que el primero esperara respuesta.

  Si la respuesta es 404, el consumidor aún no procesó el mensaje: esperar un
  segundo y repetir.
}
